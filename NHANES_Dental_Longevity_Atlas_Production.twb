 /></datasource-dependencies><filter class="categorical" column="[federated.1q3hzrf1ynnsoz1f101vl09v785x].[none:record_stream:nk]"><groupfilter function="member" level="[none:record_stream:nk]" member="&quot;Clinical_Respondent&quot;" /></filter><aggregation value="true" /></view><style><style-rule element="header"><format attr="color" value="#3B3A57" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="cell"><format attr="color" value="#3B3A57" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="axis"><format attr="color" value="#8A88A6" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="label"><format attr="color" value="#8A88A6" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="pane"><format attr="background-color" value="#00000000" /></style-rule><style-rule element="table"><format attr="background-color" value="#00000000" /></style-rule></style><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Line" /><encodings><color column="[federated.1q3hzrf1ynnsoz1f101vl09v785x].[none:time_since_last_dental_visit:nk]" /></encodings><style><style-rule element="mark" /></style></pane></panes><rows>[federated.1q3hzrf1ynnsoz1f101vl09v785x].[avg:remaining_permanent_teeth_28:qk]</rows><cols>[federated.1q3hzrf1ynnsoz1f101vl09v785x].[none:age_decade:nk]</cols></table><simple-id uuid="{26291048-86B4-4B96-8151-12AA46D4A0B4}" /></worksheet><worksheet name="W06_Equity_Care_Reason_Bar"><table><view><datasources><datasource caption="NHANES_Dental_Longevity_Master" name="federated.1q3hzrf1ynnsoz1f101vl09v785x" /></datasources><datasource-dependencies datasource="federated.1q3hzrf1ynnsoz1f101vl09v785x"><column caption="Record Stream" datatype="string" name="[record_stream]" role="dimension" type="nominal" /><column-instance column="[record_stream]" derivation="None" name="[none:record_stream:nk]" pivot="key" type="nominal" /><column caption="Remaining Permanent Teeth 28" datatype="integer" name="[remaining_permanent_teeth_28]" role="measure" type="quantitative" /><column-instance column="[remaining_permanent_teeth_28]" derivation="Avg" name="[avg:remaining_permanent_teeth_28:qk]" pivot="key" type="quantitative" /><column caption="Income Tier" datatype="string" name="[income_tier]" role="dimension" type="nominal" /><column-instance column="[income_tier]" derivation="None" name="[none:income_tier:nk]" pivot="key" type="nominal" /><column caption="Care Pattern Category" datatype="string" name="[care_pattern_category]" role="dimension" type="nominal" /><column-instance column="[care_pattern_category]" derivation="None" name="[none:care_pattern_category:nk]" pivot="key" type="nominal" /></datasource-dependencies><filter class="categorical" column="[federated.1q3hzrf1ynnsoz1f101vl09v785x].[none:record_stream:nk]"><groupfilter function="member" level="[none:record_stream:nk]" member="&quot;Clinical_Respondent&quot;" /></filter><aggregation value="true" /></view><style><style-rule element="header"><format attr="color" value="#3B3A57" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="cell"><format attr="color" value="#3B3A57" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="axis"><format attr="color" value="#8A88A6" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="label"><format attr="color" value="#8A88A6" /><format attr="font-family" value="Segoe UI" /><format attr="font-size" value="9" /></style-rule><style-rule element="pane"><format attr="background-color" value="#00000000" /></style-rule><style-rule element="table"><format attr="background-color" value="#00000000" /></style-rule></style><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Bar" /><encodings><color column="[federated.1q3hzrf1ynnsoz1f101vl09v785x].[none:care_pattern_category:nk]" /></encodings><style><style-rule element="mark" /></style></pane></panes><rows>[federated.1q3hzrf1ynnsoz1f101vl09v785x].[none:income_tier:nk]</rows><cols>[federated.1q3hzrf1ynnsoz1f101vl09v785x].[avg:remaining_permanent_teeth_28:qk]</cols></table><simple-id uuid="{8D635916-2015-426F-920D-89386133B83C}" /></worksheet></worksheets>
  <dashboards>
    <dashboard name="The_Adult_Dental_Atlas"><style><style-rule element="table"><format attr="background-color" value="#F5F9FD" /></style-rule></style><size maxheight="3600" maxwidth="1100" minheight="3600" minwidth="1100" sizing-mode="fixed" /><zones><zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0" /><zone h="3889" id="2" type-v2="text" w="92727" x="3636" y="833"><formatted-text><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="28" bold="true">THE ADULT DENTAL ATLAS
</run><run fontalignment="0" fontcolor="#7FA8D9" fontname="Century Gothic" fontsize="13" bold="true">Epidemiological Trajectories of Lifetime Tooth Retention Across 24,625 U.S. CDC NHANES Cohorts
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="10" bold="false">Visual Analytics &amp; Clinical Synthesis by Rama Wijaya  |  Dataset: U.S. CDC NHANES (2009–2014) Clinical Microdata</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="3056" id="3" type-v2="text" w="29091" x="3636" y="5278"><formatted-text><run fontalignment="0" fontcolor="#E57C9A" fontname="Century Gothic" fontsize="26" bold="true">28 → 7
</run><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="11" bold="true">National Median Retained Teeth
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">Sharp decline from age 20 to 80+ across general adult population</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="3056" id="4" type-v2="text" w="29091" x="35455" y="5278"><formatted-text><run fontalignment="0" fontcolor="#7FA8D9" fontname="Century Gothic" fontsize="26" bold="true">+4.8 Teeth
</run><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="11" bold="true">Preventive Recall Advantage
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">Routine checkup patients preserve 4.8 more teeth by age 70</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="3056" id="5" type-v2="text" w="29091" x="67273" y="5278"><formatted-text><run fontalignment="0" fontcolor="#9AD9C3" fontname="Century Gothic" fontsize="26" bold="true">74% vs 28%
</run><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="11" bold="true">Preventive Checkup Ratio
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">Highest vs lowest income tier attending dentist proactively</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="2361" id="6" type-v2="text" w="92727" x="3636" y="8889"><formatted-text><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="15" bold="true">Chapter 01  |  The Anatomical Permanent Dentition Map
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="10" bold="false">Visualizing tooth survival probabilities for all 32 permanent teeth across age screening cohorts (n=27,328 vertices).
</run><run fontalignment="0" fontcolor="#B9A7E0" fontname="Segoe UI" fontsize="9" bold="false">Use the Pages Controller on the right to scrub across age cohorts from 20 to 80 years old.</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="15000" id="7" name="W01_Anatomical_Arch_Map" show-title="false" w="60000" x="3636" y="11667"><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="1667" id="8" name="W01_Anatomical_Arch_Map" type-v2="currpage" w="30000" x="66364" y="12222" /><zone h="12222" id="9" type-v2="text" w="30000" x="66364" y="14444"><formatted-text><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="13" bold="true">Clinical Arch Dynamics

</run><run fontalignment="0" fontcolor="#E57C9A" fontname="Segoe UI" fontsize="10" bold="true">• First Molars (#3, #14, #19, #30): </run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">Earliest permanent teeth to erupt (age 6) and highest lifetime loss rate due to deep occlusal fissures.

</run><run fontalignment="0" fontcolor="#7FA8D9" fontname="Segoe UI" fontsize="10" bold="true">• Mandibular Canines (#22, #27): </run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">Most resilient teeth in human dentition; robust single root preserves functional anchorage well into the 80s.

</run><run fontalignment="0" fontcolor="#9AD9C3" fontname="Segoe UI" fontsize="10" bold="true">• Periodontal Boundary: </run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">Interdental bone loss accelerates after age 45, shifting tooth prognosis from restorative to periodontal.</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="1944" id="10" type-v2="text" w="92727" x="3636" y="27222"><formatted-text><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="15" bold="true">Chapter 02  |  The Age-40 Divergence &amp; Cohort Dispersion
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="10" bold="false">Dentition remains largely intact through the 30s. At age 40, variance expands dramatically between proactive and vulnerable cohorts.</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="13333" id="11" name="W02_Decade_Retention_Slope" show-title="false" w="45000" x="3636" y="29722"><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="13333" id="12" name="W03_Cohort_Dispersion_Jitter" show-title="false" w="45000" x="51364" y="29722"><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="1944" id="13" type-v2="text" w="92727" x="3636" y="43611"><formatted-text><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="15" bold="true">Chapter 03  |  Impact of Daily Flossing &amp; Dental Visit Recency
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="10" bold="false">Daily interdental plaque removal and visit frequency directly decouple tooth retention from chronological aging.</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="13333" id="14" name="W04_Flossing_Habit_Trajectory" show-title="false" w="45000" x="3636" y="46111"><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="13333" id="15" name="W05_Visit_Recency_Trajectory" show-title="false" w="45000" x="51364" y="46111"><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="1944" id="16" type-v2="text" w="92727" x="3636" y="60000"><formatted-text><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="15" bold="true">Chapter 04  |  The Oral Health Wealth Gap: Income vs Care Reason
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="10" bold="false">Stratified analysis reveals lower-income cohorts visit dentists primarily during acute pain, whereas high-income cohorts attend routine prophylaxis.</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="14444" id="17" name="W06_Equity_Care_Reason_Bar" show-title="false" w="92727" x="3636" y="62500"><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone><zone h="9722" id="18" type-v2="text" w="92727" x="3636" y="77500"><formatted-text><run fontalignment="0" fontcolor="#3B3A57" fontname="Century Gothic" fontsize="15" bold="true">Chapter 05  |  Clinical Synthesis &amp; Kaizen Action Protocols

</run><run fontalignment="0" fontcolor="#7FA8D9" fontname="Century Gothic" fontsize="12" bold="true">Key Analytical Takeaways:
</run><run fontalignment="0" fontcolor="#3B3A57" fontname="Segoe UI" fontsize="10" bold="false">1. Upstream Determinants: Tooth loss is not an inevitable biological fate; it is mediated by early childhood habits, fluoride exposure, and socioeconomic access.
</run><run fontalignment="0" fontcolor="#3B3A57" fontname="Segoe UI" fontsize="10" bold="false">2. The Prevention Multiplier: Patients who schedule routine 6-month prophylaxis maintain 22+ functional teeth into their 70s, avoiding costly extractions and prosthetics.
</run><run fontalignment="0" fontcolor="#3B3A57" fontname="Segoe UI" fontsize="10" bold="false">3. Immediate Patient Protocol: Schedule a comprehensive periodontal screening today, and pre-book the subsequent 6-month recall before leaving the operatory.

</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Century Gothic" fontsize="11" bold="true">Data Architecture &amp; Methodological Notes:
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">• Study Sample: 24,625 respondents aged 20–80 examined in mobile examination centers (MEC) across CDC NHANES survey cycles 2009–2014.
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">• Clinical Protocols: Full-mouth periodontal probing at 6 sites per tooth (excluding 3rd molars) and coronal examination for untreated caries and restorations.
</run><run fontalignment="0" fontcolor="#8A88A6" fontname="Segoe UI" fontsize="9" bold="false">• Tableau Implementation: 100% native polygon mapping, self-contained Hyper extract, Twilight Sky anime aesthetic.</run></formatted-text><zone-style><format attr="background-color" value="#FFFFFF" /><format attr="border-color" value="#E0EAF4" /><format attr="border-style" value="solid" /><format attr="border-width" value="1" /><format attr="margin" value="4" /><format attr="padding" value="12" /></zone-style></zone></zones><simple-id uuid="{CD748235-7A78-43B4-BB75-BFD7E67E8F0B}" /></dashboard></dashboards>
